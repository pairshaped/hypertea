{
  "name": "@pairshaped/hypertea",
  "version": "0.0.0",
  "description": "A tiny TypeScript TEA runtime for SSR client islands.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./program": {
      "types": "./dist/program.d.ts",
      "import": "./dist/program.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./webmcp": {
      "types": "./dist/webmcp.d.ts",
      "import": "./dist/webmcp.js"
    },
    "./socket-transport": {
      "types": "./dist/socket-transport.d.ts",
      "import": "./dist/socket-transport.js"
    },
    "./eslint": {
      "types": "./eslint-purity.d.ts",
      "import": "./eslint-purity.js"
    },
    "./webmcp/generate": {
      "types": "./dist/webmcp-generate.d.ts",
      "import": "./dist/webmcp-generate.js"
    }
  },
  "files": [
    "dist",
    "eslint-purity.d.ts",
    "eslint-purity.js",
    "README.md",
    "bin/generate-webmcp.mjs"
  ],
  "scripts": {
    "preinstall": "node -e 'const agent=process.env.npm_config_user_agent??\"\";if(!agent.startsWith(\"pnpm/\")){console.error(\"error: use pnpm for this repository\");process.exit(1)}'",
    "bench": "pnpm run build && node benchmark/dom-patching.mjs",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage && pnpm run build && pnpm run check:webmcp-example",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:webmcp": "pnpm run build && pnpm run check:webmcp-example && node bin/test-webmcp.mjs",
    "test:webmcp:fallback": "pnpm run build && pnpm run check:webmcp-example && node bin/test-webmcp.mjs --fallback",
    "typecheck": "tsc --noEmit",
    "generate:webmcp-example": "node bin/generate-webmcp.mjs --project test/tsconfig.webmcp.json --source test/webmcp-tools.ts --output test/webmcp.generated.ts",
    "check:webmcp-example": "node bin/generate-webmcp.mjs --project test/tsconfig.webmcp.json --source test/webmcp-tools.ts --output test/webmcp.generated.ts --check && tsc -p test/tsconfig.webmcp.json"
  },
  "keywords": [
    "tea",
    "typescript",
    "hyperapp",
    "ssr",
    "islands"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "hyperapp": "^2.0.22",
    "jsdom": "^27.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "bin": {
    "hypertea-webmcp": "./bin/generate-webmcp.mjs"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
